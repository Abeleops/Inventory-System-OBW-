# Vercel frontend configuration
# Set this in Vercel Project Settings, not in the repository.
VITE_API_BASE_URL=https://your-render-laravel-service.onrender.com/api

# Firebase Web SDK configuration is safe to expose through the frontend,
# but Firebase Admin/service-account credentials must remain on Render.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
